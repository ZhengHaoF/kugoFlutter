<?xml version="1.0" encoding="utf-8"?>
<!--
  audio_service looks up androidNotificationIcon via Resources.getIdentifier(),
  which R8 resource shrinking cannot see. Keep the media-notification small
  icon or the process dies with "Invalid notification (no valid small icon)".
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_music" />
